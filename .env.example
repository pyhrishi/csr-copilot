# Copy to .env.local and fill in only if you want Live AI mode.
# The prototype runs fully in Simulated AI mode with none of these set.

# Optional: enables Live AI mode using accessible open-source models (Llama 3.3, Mistral, Qwen)
# Option 1: Free Groq API Key (Ultra-fast Meta Llama 3.3 70B & 3.1 8B)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Option 2: OpenRouter API Key (Free tier open-source models)
OPENROUTER_API_KEY=

# Option 3: Local Ollama (100% free, zero key required)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Option 4: Generic OpenAI-compatible open-source endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPEN_SOURCE_MODEL=llama-3.3-70b-versatile

# Option 5: Anthropic API Key fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# simulated | live — what the app starts in. Keep "simulated" for demos.
NEXT_PUBLIC_DEFAULT_MODE=simulated
